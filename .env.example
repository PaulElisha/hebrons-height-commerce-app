PORT=8000

# Change to your production URL or use LOCAL_URL for local dev
BASE_URL=http://localhost:8000
LOCAL_URL=http://localhost:8000

NODE_ENV=development
APP_STAGE=dev

# Generate via: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret

# PostgreSQL connection string
DB_URL=postgresql://user:password@localhost:5432/hhg_database

SALT=10

# Comma-separated allowed CORS origins
CORS_ORIGIN=http://localhost:3000

VERSION=1.0.0

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

PAYSTACK_INIT_URL=https://api.paystack.co/transaction/initialize
PAYSTACK_VERIFY_URL=https://api.paystack.co/transaction/verify
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Generate VAPID keys at https://web-push-codelab.glitch.me/
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

SCALER=100
